# StockWise Environment Variables
# Copy this file to `.env` and fill in values. Never commit `.env`.

# TinyFish API key for supplier research (optional).
# Core inventory/sales/forecast features work without it.
# Get access from: https://www.tinyfish.ai/
TINYFISH_API_KEY=

# App environment: development | production
STOCKWISE_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
STOCKWISE_LOG_LEVEL=INFO

# Optional: override the SQLite database location.
# Defaults to a per-user writable app-data directory, e.g.
#   Windows: %LOCALAPPDATA%\StockWise\stockwise.db
# STOCKWISE_DB_PATH=
