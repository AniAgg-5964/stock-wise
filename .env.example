# StockWise Environment Variables
# Copy this file to `.env` and fill in values. Never commit `.env`.

# TinyFish API key for supplier research (optional).
# Enables the "Live supplier research" panel on the Supplier Research screen.
# Core inventory/sales/forecast/reorder features work without it.
# Get a key from: https://agent.tinyfish.ai/api-keys
# StockWise uses only the free Search and Fetch APIs (12k searches and 1k page
# fetches per day). The metered Agent/Browser APIs are deliberately not used.
TINYFISH_API_KEY=

# App environment: development | production
STOCKWISE_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
STOCKWISE_LOG_LEVEL=INFO

# Optional: override the SQLite database location.
# Defaults to a per-user writable app-data directory, e.g.
#   Windows: %LOCALAPPDATA%\StockWise\stockwise.db
# STOCKWISE_DB_PATH=